# === OpenRouter (single key powers all 3 agents) ===
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=JARVIS-Local

# === Model IDs (change as new flagships ship) ===
# Browse: https://openrouter.ai/models
PLANNER_MODEL=openai/gpt-4o
CRITIC_MODEL=google/gemini-pro-1.5
EXECUTOR_MODEL=anthropic/claude-opus-4

# === Whisper (local STT) ===
# Sizes: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# === Wake word ===
# openWakeWord built-ins: alexa, hey_jarvis, hey_mycroft
WAKE_WORD=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# === Audio ===
MIC_DEVICE_INDEX=
SAMPLE_RATE=16000
SILENCE_THRESHOLD=0.01
SILENCE_DURATION_SEC=1.5
MAX_RECORD_SECONDS=15

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/jarvis.log

# === Memory ===
ENABLE_HISTORY=true
HISTORY_FILE=memory/history.jsonl
